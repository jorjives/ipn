# Private Motor: named drivers, a no claims discount that grows a year at a time
# and steps back two years after a fault claim (but not for glass or a non-fault
# claim), and an excess that depends on who was driving, which is only known
# when the claim comes in.
# Run it with:  python3 -m ideclare check examples/motor.idl

product "Private Motor"
  territory UK
  currency GBP
  term 12 months

inputs
  registration: text
  vehicle_value: money
  annual_mileage: integer
  ncd_years: integer
  voluntary_excess: money
  cover_type: choice of comprehensive, third_party_fire_theft
  drivers: collection of driver, 1 to 4
    age: integer
    licence_years: integer
    convictions: integer

enrichment "Vehicle lookup" from registration
  provides
    vehicle_group: integer
  when unavailable: refer because "Vehicle not recognised"
  held for the term

eligibility
  decline when any driver where age < 17 because "Drivers must be 17 or over"
  decline when any driver where convictions > 2 because "Too many convictions"
  decline when annual_mileage > 50000 because "Mileage over 50,000 needs a commercial policy"
  refer when vehicle_value > 50000 because "High value vehicles need an underwriter"
  refer when vehicle_group > 45 because "Performance vehicles need an underwriter"

cover "Accidental Damage"
  limit vehicle_value
  excess
    driver_age < 25: 550 + voluntary_excess
    otherwise: 250 + voluntary_excess
  excludes when cover_type is third_party_fire_theft because "Not covered on third party, fire and theft"

cover "Fire and Theft"
  limit vehicle_value
  excess 250 + voluntary_excess

cover "Third Party Liability"
  limit 20000000

cover Windscreen
  limit 1500
  excess 75
  excludes when cover_type is third_party_fire_theft because "Not covered on third party, fire and theft"

cover "Courtesy Car" optional
  limit 500

rating
  base 400
  factor "Vehicle group"
    vehicle_group < 10: x 0.80
    vehicle_group < 20: x 1.00
    vehicle_group < 30: x 1.30
    vehicle_group < 40: x 1.70
    otherwise: x 2.20
  factor "Youngest driver"
    lowest age of drivers < 21: x 2.50
    lowest age of drivers < 25: x 1.80
    lowest age of drivers < 30: x 1.20
    lowest age of drivers < 70: x 1.00
    otherwise: x 1.30
  factor "Convictions"
    total convictions of drivers is 0: x 1.00
    otherwise: x 1.40
  factor "Mileage"
    annual_mileage <= 5000: x 0.90
    annual_mileage <= 12000: x 1.00
    otherwise: x 1.20
  factor "Cover type"
    cover_type is third_party_fire_theft: x 0.70
    otherwise: x 1.00
  factor "Voluntary excess"
    voluntary_excess >= 500: x 0.85
    voluntary_excess >= 250: x 0.92
    otherwise: x 1.00
  factor "No claims discount"
    ncd_years >= 5: x 0.35
    ncd_years is 4: x 0.40
    ncd_years is 3: x 0.50
    ncd_years is 2: x 0.60
    ncd_years is 1: x 0.70
    otherwise: x 1.00
  add "Courtesy car" 30 when "Courtesy Car" selected
  minimum 100
  tax IPT 12%
  fee "Arrangement fee" 25

lifecycle
  cooling off 14 days, full refund
  cancellation by customer: refund pro rata, fee 50
  cancellation by insurer: refund pro rata
  adjustment: reprice, charge pro rata difference, fee 25
  renewal
    invite 21 days before expiry
    index ncd_years by 1, at most 9
    decline when claims in term >= 3 because "Three fault claims in the year"

claims
  claim "Accidental Damage"
    asks
      driver_age: integer
      fault: yes/no
    pays claimed amount up to limit, less excess
    counts towards claims in term when fault is yes
  claim "Fire and Theft"
    requires crime_reference
    pays claimed amount up to limit, less excess
  claim "Third Party Liability"
    asks
      fault: yes/no
    pays claimed amount up to limit
    counts towards claims in term when fault is yes
  claim Windscreen
    pays claimed amount up to limit, less excess
    does not count towards claims in term
  # The industry step-back: two years for the first fault claim, a further two for the second.
  after 1 claim in term
    renewal
      index ncd_years by -2, at least 0
  after 2 claims in term
    renewal
      index ncd_years by -4, at least 0

# --- Eligibility and enrichment -------------------------------------------
# Baseline risk: 400 x 0.92 voluntary excess x 0.35 for five years NCD = 128.80 net,
# IPT 15.46, fee 25, total 169.26.

scenario "A family hatchback with one experienced driver"
  given registration "AB12 CDE", vehicle_group 15, vehicle_value 12000, annual_mileage 8000, ncd_years 5, voluntary_excess 250, cover_type comprehensive
  given driver age 35, licence_years 15, convictions 0
  expect eligible
  expect net 128.80
  expect tax IPT 15.46
  expect fee "Arrangement fee" 25.00
  expect premium 169.26

scenario "An unrecognised registration is referred"
  given registration "ZZ99 ZZZ", vehicle_value 12000, annual_mileage 8000, ncd_years 5, voluntary_excess 250, cover_type comprehensive
  given driver age 35, licence_years 15, convictions 0
  expect referred "Vehicle not recognised"

scenario "A driver under seventeen declines the policy"
  given registration "AB12 CDE", vehicle_group 15, vehicle_value 12000, annual_mileage 8000, ncd_years 5, voluntary_excess 250, cover_type comprehensive
  given driver age 35, licence_years 15, convictions 0
  given driver age 16, licence_years 0, convictions 0
  expect declined "Drivers must be 17 or over"

# --- Rating on the drivers -------------------------------------------------

scenario "Adding a young named driver rates on the youngest"
  given registration "AB12 CDE", vehicle_group 15, vehicle_value 12000, annual_mileage 8000, ncd_years 5, voluntary_excess 250, cover_type comprehensive
  given driver age 35, licence_years 15, convictions 0
  given driver age 19, licence_years 1, convictions 0
  expect factor "Youngest driver" x 2.50
  expect net 322.00

scenario "Any conviction across the drivers loads the premium"
  given registration "AB12 CDE", vehicle_group 15, vehicle_value 12000, annual_mileage 8000, ncd_years 5, voluntary_excess 250, cover_type comprehensive
  given driver age 35, licence_years 15, convictions 0
  given driver age 40, licence_years 20, convictions 1
  expect factor "Convictions" x 1.40
  expect net 180.32

scenario "Third party, fire and theft is cheaper and drops two sections"
  given registration "AB12 CDE", vehicle_group 15, vehicle_value 12000, annual_mileage 8000, ncd_years 5, voluntary_excess 250, cover_type third_party_fire_theft
  given driver age 35, licence_years 15, convictions 0
  expect cover "Accidental Damage" excluded "Not covered on third party, fire and theft"
  expect cover Windscreen excluded
  expect cover "Fire and Theft" included
  # 128.80 x 0.70 = 90.16, floored to the 100 minimum
  expect net 100.00

scenario "A new driver with no discount"
  given registration "AB12 CDE", vehicle_group 15, vehicle_value 12000, annual_mileage 8000, ncd_years 0, voluntary_excess 0, cover_type comprehensive
  given driver age 22, licence_years 1, convictions 0
  # 400 x 1.80
  expect net 720.00

# --- The excess depends on who was driving ---------------------------------

scenario "The excess is higher when a young driver was at the wheel"
  given registration "AB12 CDE", vehicle_group 15, vehicle_value 12000, annual_mileage 8000, ncd_years 5, voluntary_excess 250, cover_type comprehensive
  given driver age 35, licence_years 15, convictions 0
  given driver age 19, licence_years 1, convictions 0
  when bound on 2026-01-01
  when claim "Accidental Damage" for 3000 on 2026-03-01 with driver_age 35, fault yes
  # 250 compulsory + 250 voluntary
  expect payout 2500.00
  when claim "Accidental Damage" for 3000 on 2026-05-01 with driver_age 19, fault yes
  # 550 compulsory + 250 voluntary
  expect payout 2200.00

scenario "A claim must say who was driving"
  given registration "AB12 CDE", vehicle_group 15, vehicle_value 12000, annual_mileage 8000, ncd_years 5, voluntary_excess 250, cover_type comprehensive
  given driver age 35, licence_years 15, convictions 0
  when bound on 2026-01-01
  when claim "Accidental Damage" for 3000 on 2026-03-01 with fault yes
  expect claim declined "driver_age is required"

scenario "A total loss pays the vehicle value less the excess"
  given registration "AB12 CDE", vehicle_group 15, vehicle_value 12000, annual_mileage 8000, ncd_years 5, voluntary_excess 250, cover_type comprehensive
  given driver age 35, licence_years 15, convictions 0
  when bound on 2026-01-01
  when claim "Fire and Theft" for 15000 on 2026-03-01 with crime_reference
  expect payout 11500.00

# --- No claims discount --------------------------------------------------

scenario "A claim-free year adds a year of discount, up to nine"
  given registration "AB12 CDE", vehicle_group 15, vehicle_value 12000, annual_mileage 8000, ncd_years 5, voluntary_excess 250, cover_type comprehensive
  given driver age 35, licence_years 15, convictions 0
  when bound on 2026-01-01
  expect renewal premium 169.26
  when renewed on 2027-01-01
  expect premium 169.26

scenario "A fault claim steps the discount back two years"
  given registration "AB12 CDE", vehicle_group 15, vehicle_value 12000, annual_mileage 8000, ncd_years 5, voluntary_excess 250, cover_type comprehensive
  given driver age 35, licence_years 15, convictions 0
  when bound on 2026-01-01
  when claim "Accidental Damage" for 3000 on 2026-03-01 with driver_age 35, fault yes
  expect claims in term 1
  # three years of discount: 400 x 0.92 x 0.50 = 184.00, IPT 22.08, fee 25
  expect renewal premium 231.08

scenario "A second fault claim steps back to one year"
  given registration "AB12 CDE", vehicle_group 15, vehicle_value 12000, annual_mileage 8000, ncd_years 5, voluntary_excess 250, cover_type comprehensive
  given driver age 35, licence_years 15, convictions 0
  when bound on 2026-01-01
  when claim "Accidental Damage" for 3000 on 2026-03-01 with driver_age 35, fault yes
  when claim "Third Party Liability" for 8000 on 2026-06-01 with fault yes
  expect claims in term 2
  # one year of discount: 400 x 0.92 x 0.70 = 257.60, IPT 30.91, fee 25
  expect renewal premium 313.51

scenario "Glass and non-fault claims are paid but leave the discount alone"
  given registration "AB12 CDE", vehicle_group 15, vehicle_value 12000, annual_mileage 8000, ncd_years 5, voluntary_excess 250, cover_type comprehensive
  given driver age 35, licence_years 15, convictions 0
  when bound on 2026-01-01
  when claim Windscreen for 400 on 2026-02-01
  expect payout 325.00
  when claim "Accidental Damage" for 2000 on 2026-04-01 with driver_age 35, fault no
  expect payout 1500.00
  when claim "Third Party Liability" for 5000 on 2026-05-01 with fault no
  expect payout 5000.00
  expect claims in term 0
  expect renewal premium 169.26

scenario "The discount never goes below nothing"
  given registration "AB12 CDE", vehicle_group 15, vehicle_value 12000, annual_mileage 8000, ncd_years 1, voluntary_excess 250, cover_type comprehensive
  given driver age 35, licence_years 15, convictions 0
  when bound on 2026-01-01
  when claim "Accidental Damage" for 3000 on 2026-03-01 with driver_age 35, fault yes
  # no discount at all: 400 x 0.92 = 368.00, IPT 44.16, fee 25
  expect renewal premium 437.16

scenario "Three fault claims in a year and the renewal is declined"
  given registration "AB12 CDE", vehicle_group 15, vehicle_value 12000, annual_mileage 8000, ncd_years 5, voluntary_excess 250, cover_type comprehensive
  given driver age 35, licence_years 15, convictions 0
  when bound on 2026-01-01
  when claim "Accidental Damage" for 3000 on 2026-03-01 with driver_age 35, fault yes
  when claim "Accidental Damage" for 3000 on 2026-05-01 with driver_age 35, fault yes
  when claim "Accidental Damage" for 3000 on 2026-07-01 with driver_age 35, fault yes
  expect renewal declined "Three fault claims in the year"

# --- Lifecycle -----------------------------------------------------------

scenario "Adding a driver mid term charges the difference plus the fee"
  given registration "AB12 CDE", vehicle_group 15, vehicle_value 12000, annual_mileage 8000, ncd_years 5, voluntary_excess 250, cover_type comprehensive
  given driver age 35, licence_years 15, convictions 0
  when bound on 2026-01-01
  when adjusted on 2026-07-02 adding driver age 19, licence_years 1, convictions 0
  # earning goes from 144.26 to 360.64: 216.38 x 183/365 = 108.49, plus 25 fee
  expect additional premium 133.49

scenario "Cancelling mid term refunds pro rata less the fee"
  given registration "AB12 CDE", vehicle_group 15, vehicle_value 12000, annual_mileage 8000, ncd_years 5, voluntary_excess 250, cover_type comprehensive
  given driver age 35, licence_years 15, convictions 0
  when bound on 2026-01-01
  when cancelled by customer on 2026-07-02
  # 144.26 x 183/365 = 72.33, less 50
  expect refund 22.33
