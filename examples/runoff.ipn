# Professional Indemnity Run-off: the cover a practice buys when it closes. No new
# work is done, so the exposure is only claims that arrive later for work already
# done, and the regulators for solicitors, accountants and architects require it
# for six years. One premium buys the whole period; there is no renewal and no
# mid-term change, and the claims-made mechanism from the live policy carries
# over unchanged: the claim must be made in the period, for work done between the
# retroactive date and the day the practice ceased.
# Run it with:  python3 -m ipngine check examples/runoff.ipn

product "Professional Indemnity Run-off"
  territory UK
  term 6 years

inputs
  profession: choice of accountant, architect, consultant
  final_year_turnover: money
  limit_of_indemnity: money
  retroactive_date: date
  cessation_date: date
  open_claims: integer

eligibility
  decline when open_claims > 0 because "Open claims must be settled under the live policy before run-off"
  decline when limit_of_indemnity > 2000000 because "Run-off limits over 2,000,000 need a bespoke policy"
  refer when final_year_turnover > 1000000 because "Run-off for a practice over 1,000,000 needs an underwriter"

cover "Professional Indemnity"
  limit limit_of_indemnity per term
  excess 1000

rating
  # Roughly two and a half years' worth of the live premium, paid once, falling with the profession's tail.
  base 1.2% of final_year_turnover * 2.5
  factor "Profession"
    profession is consultant: x 1.00
    profession is accountant: x 1.30
    otherwise: x 1.60
  factor "Limit of indemnity"
    limit_of_indemnity <= 250000: x 0.80
    limit_of_indemnity <= 1000000: x 1.00
    otherwise: x 1.30
  minimum 750
  tax IPT 12%
  fee "Policy fee" 35

lifecycle
  cooling off 14 days, full refund
  cancellation by insurer: refund pro rata
  adjustment: not allowed
  renewal: none

claims
  claim "Professional Indemnity"
    asks
      work_date: date
    requires written_demand
    pays claimed amount, less excess, up to limit
    decline when work_date < retroactive_date because "The work predates the retroactive date"
    decline when work_date > cessation_date because "The work postdates the cessation of the practice"
    decline when reported after 30 days because "Claims must be notified within 30 days of being made"

# --- One premium for six years -------------------------------------------

scenario "A closing consultancy buys six years of run-off"
  given profession consultant, final_year_turnover 400000, limit_of_indemnity 1000000, retroactive_date 2018-04-01, cessation_date 2026-03-31, open_claims 0
  expect eligible
  # 1.2% of 400,000 = 4,800, x 2.5
  expect net 12000.00
  expect tax IPT 1440.00
  expect premium 13475.00
  when bound on 2026-04-01
  expect expiry 2032-04-01
  expect status live on 2032-03-31
  expect status expired on 2032-04-01
  expect renewal declined "The policy is not renewable"

scenario "The customer cannot cancel or change run-off cover"
  given profession consultant, final_year_turnover 400000, limit_of_indemnity 1000000, retroactive_date 2018-04-01, cessation_date 2026-03-31, open_claims 0
  when bound on 2026-04-01
  when cancelled by customer on 2027-04-01
  expect refused
  when adjusted on 2027-04-01 with limit_of_indemnity 250000
  expect refused "adjustment is not allowed"

scenario "Open claims stay with the live policy"
  given profession consultant, final_year_turnover 400000, limit_of_indemnity 1000000, retroactive_date 2018-04-01, cessation_date 2026-03-31, open_claims 1
  expect declined "Open claims must be settled under the live policy before run-off"

# --- Claims made in the run-off period -----------------------------------

scenario "A claim in year four for work done while trading is paid"
  given profession consultant, final_year_turnover 400000, limit_of_indemnity 1000000, retroactive_date 2018-04-01, cessation_date 2026-03-31, open_claims 0
  when bound on 2026-04-01
  when claim "Professional Indemnity" for 80000 on 2029-09-15 with written_demand, work_date 2025-11-20
  expect payout 79000.00
  expect cover "Professional Indemnity" remaining 921000

scenario "Work after the practice ceased is not covered"
  given profession consultant, final_year_turnover 400000, limit_of_indemnity 1000000, retroactive_date 2018-04-01, cessation_date 2026-03-31, open_claims 0
  when bound on 2026-04-01
  when claim "Professional Indemnity" for 80000 on 2027-01-10 with written_demand, work_date 2026-05-01
  expect claim declined "The work postdates the cessation of the practice"

scenario "A claim made after the six years falls outside the cover"
  given profession consultant, final_year_turnover 400000, limit_of_indemnity 1000000, retroactive_date 2018-04-01, cessation_date 2026-03-31, open_claims 0
  when bound on 2026-04-01
  when claim "Professional Indemnity" for 80000 on 2032-06-01 with written_demand, work_date 2025-11-20
  expect claim declined "policy was expired on 2032-06-01"

scenario "The aggregate limit is for the whole six years"
  given profession consultant, final_year_turnover 400000, limit_of_indemnity 250000, retroactive_date 2018-04-01, cessation_date 2026-03-31, open_claims 0
  when bound on 2026-04-01
  when claim "Professional Indemnity" for 200000 on 2027-06-01 with written_demand, work_date 2025-01-15
  expect payout 199000.00
  when claim "Professional Indemnity" for 200000 on 2030-06-01 with written_demand, work_date 2024-08-01
  # 199,000 would be due; 51,000 is left of the limit for the period
  expect payout 51000.00
  when claim "Professional Indemnity" for 5000 on 2031-06-01 with written_demand, work_date 2024-08-01
  expect claim declined "Professional Indemnity limit for the term is used up"
