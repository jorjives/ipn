# Cycle Cover: a worked example exercising every part of the iDeclare language.
# Run it with:  python3 -m ideclare check examples/cycle.idl

product "Cycle Cover"
  territory UK
  currency GBP
  term 12 months

inputs
  bike_value: money
  rider_age: integer
  security: choice of bronze, silver, gold
  racing: yes/no
  previous_claims: integer
  bike_age: integer

eligibility
  decline when rider_age < 16 because "Rider must be at least 16"
  decline when bike_value > 15000 because "Bikes over 15,000 need a specialist policy"
  refer when previous_claims >= 3 because "Claims history needs an underwriter"

cover Theft
  limit bike_value
  excess 10% of claim, minimum 50
  excludes when security is bronze and bike_value > 2000 because "Gold or silver rated lock required"

cover "Accidental Damage"
  limit bike_value
  excess 100

cover Racing optional
  limit 5000
  excess 250
  available when racing is yes

rating
  base 3.5% of bike_value
  factor "Rider age"
    rider_age < 25: x 1.40
    rider_age < 40: x 1.00
    otherwise: x 0.90
  factor "Security"
    security is gold: x 0.85
    security is silver: x 0.95
    otherwise: x 1.00
  factor "Claims history"
    previous_claims is 0: x 0.90
    previous_claims is 1: x 1.10
    otherwise: x 1.35
  add "Racing cover" 45 when Racing selected
  minimum 60
  maximum 800
  tax IPT 12%
  fee "Admin fee" 10
  round to 0.01

lifecycle
  cooling off 14 days, full refund
  cancellation by customer: refund pro rata, fee 25
  cancellation by insurer: refund pro rata
  adjustment: reprice, charge pro rata difference, fee 10
  lapse when unpaid after 30 days
  renewal
    invite 21 days before expiry
    increase capped at 20%
    decrease collared at 10%
    index bike_value by 5%
    index rider_age by 1
    decline when claims in term >= 3 because "Three or more claims in the year"
    decline when rider_age > 80 because "Rider is over the age limit"

claims
  claim Theft
    requires police_report, crime_reference
    pays claimed amount up to limit, less excess
    decline when reported after 30 days because "Theft must be reported within 30 days"
    decline when claimed > bike_value because "Claim exceeds the insured value"
    depreciation
      bike_age < 1: x 1.00
      bike_age < 3: x 0.85
      otherwise: x 0.70
  claim "Accidental Damage"
    pays claimed amount up to limit, less excess
  claim Racing
    pays claimed amount up to limit, less excess
  after 1 claim in term
    cancellation by customer: no refund
  after 2 claims in term: renewal load x 1.25

# --- Eligibility ---------------------------------------------------------

scenario "Standard rider is eligible"
  given bike_value 2000, rider_age 30, security gold, racing no, previous_claims 0, bike_age 0
  expect eligible

scenario "Under 16 is declined"
  given bike_value 2000, rider_age 15, security gold, racing no, previous_claims 0, bike_age 0
  expect declined "Rider must be at least 16"

scenario "Heavy claims history is referred"
  given bike_value 2000, rider_age 30, security gold, racing no, previous_claims 3, bike_age 0
  expect referred "Claims history needs an underwriter"

scenario "Decline outranks refer"
  given bike_value 20000, rider_age 30, security gold, racing no, previous_claims 3, bike_age 0
  expect declined

# --- Covers --------------------------------------------------------------

scenario "Standard covers included, optional cover not selected"
  given bike_value 2000, rider_age 30, security gold, racing no, previous_claims 0, bike_age 0
  expect cover Theft included
  expect cover Theft limit 2000
  expect cover "Accidental Damage" included
  expect cover Racing "not selected"

scenario "Poor lock excludes theft on an expensive bike"
  given bike_value 3000, rider_age 30, security bronze, racing no, previous_claims 0, bike_age 0
  expect cover Theft excluded "Gold or silver rated lock required"
  expect cover "Accidental Damage" included

scenario "Racing cover needs the racing answer"
  given bike_value 3000, rider_age 30, security gold, racing no, previous_claims 0, bike_age 0
  select Racing
  expect cover Racing "not available"

scenario "Racing cover selected and available"
  given bike_value 3000, rider_age 30, security gold, racing yes, previous_claims 0, bike_age 0
  select Racing
  expect cover Racing included
  expect cover Racing limit 5000

# --- Rating --------------------------------------------------------------

scenario "Young rider with a gold lock"
  given bike_value 2000, rider_age 22, security gold, racing no, previous_claims 0, bike_age 0
  # 3.5% of 2000 = 70, x 1.40 age, x 0.85 security, x 0.90 no claims = 74.97
  expect factor "Rider age" x 1.40
  expect factor "Security" x 0.85
  expect net 74.97
  expect tax IPT 9.00
  expect fee "Admin fee" 10.00
  expect premium 93.97

scenario "Minimum premium applies to a cheap bike"
  given bike_value 500, rider_age 45, security gold, racing no, previous_claims 0, bike_age 0
  # 17.50 x 0.90 x 0.85 x 0.90 = 12.05, floored to 60
  expect net 60.00
  expect premium 77.20

scenario "Racing cover adds a flat amount before the minimum and tax"
  given bike_value 4000, rider_age 30, security silver, racing yes, previous_claims 1, bike_age 0
  select Racing
  # 140 x 1.00 x 0.95 x 1.10 = 146.30, + 45 = 191.30
  expect net 191.30
  expect tax IPT 22.96
  expect premium 224.26

scenario "Maximum premium caps an expensive high risk"
  given bike_value 15000, rider_age 22, security bronze, racing no, previous_claims 2, bike_age 0
  # 525 x 1.40 x 1.00 x 1.35 = 992.25, capped at 800
  expect net 800.00
  expect premium 906.00

# --- Lifecycle -----------------------------------------------------------
# Baseline risk below: net 74.97, IPT 9.00, fee 10.00, total 93.97.
# The earning part (net + IPT) is 83.97; the fee is earned on day one.

scenario "Policy is bound, goes live and expires"
  given bike_value 2000, rider_age 22, security gold, racing no, previous_claims 0, bike_age 0
  when bound on 2026-03-01
  expect status bound on 2026-02-20
  expect status live on 2026-03-01
  expect expiry 2027-03-01
  expect status expired on 2027-03-01

scenario "Cancelling within cooling off refunds everything"
  given bike_value 2000, rider_age 22, security gold, racing no, previous_claims 0, bike_age 0
  when bound on 2026-01-01
  when cancelled by customer on 2026-01-10
  expect refund 93.97
  expect status cancelled

scenario "Customer cancels mid term: pro rata less the fee"
  given bike_value 2000, rider_age 22, security gold, racing no, previous_claims 0, bike_age 0
  when bound on 2026-01-01
  when cancelled by customer on 2026-04-11
  # 265 of 365 days unused: 83.97 x 265/365 = 60.96, less 25 fee
  expect refund 35.96
  expect status live on 2026-04-10
  expect status cancelled on 2026-04-11

scenario "Insurer cancels mid term: pro rata, no fee"
  given bike_value 2000, rider_age 22, security gold, racing no, previous_claims 0, bike_age 0
  when bound on 2026-01-01
  when cancelled by insurer on 2026-04-11
  expect refund 60.96

scenario "Unpaid policy lapses after 30 days unless paid"
  given bike_value 2000, rider_age 22, security gold, racing no, previous_claims 0, bike_age 0
  when bound on 2026-01-01 unpaid
  expect status live on 2026-01-31
  expect status lapsed on 2026-02-01
  when paid on 2026-02-05
  expect status live on 2026-02-06

scenario "Mid term adjustment charges the pro rata difference plus a fee"
  given bike_value 2000, rider_age 22, security gold, racing no, previous_claims 0, bike_age 0
  when bound on 2026-01-01
  when adjusted on 2026-04-11 with bike_value 3000
  # new net 112.46 + IPT 13.50 = 125.96; difference 41.99 x 265/365 = 30.49, plus 10 fee
  expect additional premium 40.49
  expect premium 135.96

scenario "Adjusting down returns premium"
  given bike_value 3000, rider_age 22, security gold, racing no, previous_claims 0, bike_age 0
  when bound on 2026-01-01
  when adjusted on 2026-04-11 with bike_value 2000
  # -41.99 x 265/365 = -30.49, plus 10 fee
  expect return premium 20.49

scenario "Renewal is invited 21 days before expiry, priced on indexed answers"
  given bike_value 2000, rider_age 22, security gold, racing no, previous_claims 0, bike_age 0
  when bound on 2026-01-01
  expect renewal invite 2026-12-11
  # bike_value 2100 and rider_age 23 at renewal: 73.50 x 1.40 x 0.85 x 0.90 = 78.72, IPT 9.45, fee 10
  expect renewal premium 98.17
  when renewed on 2027-01-01
  expect status renewed on 2026-06-01
  expect status live on 2027-06-01
  expect expiry 2028-01-01

scenario "Renewal declined on age"
  given bike_value 2000, rider_age 79, security gold, racing no, previous_claims 0, bike_age 0
  when bound on 2026-01-01
  when adjusted on 2026-06-01 with rider_age 81
  expect renewal declined "Rider is over the age limit"

scenario "Inflation: the sum insured is indexed 5% at renewal"
  given bike_value 4000, rider_age 30, security gold, racing no, previous_claims 0, bike_age 0
  when bound on 2026-01-01
  expect premium 129.95
  # priced on bike_value 4200 and rider_age 31: net 112.46, IPT 13.50, fee 10
  expect renewal premium 135.96
  when renewed on 2027-01-01
  expect premium 135.96

scenario "Collar: a renewal cannot fall more than 10%"
  given bike_value 2000, rider_age 24, security gold, racing no, previous_claims 0, bike_age 0
  when bound on 2026-01-01
  expect premium 93.97
  # at 25 the age factor drops to 1.00 and the minimum premium applies: 77.20 uncollared
  expect renewal premium 84.57

# --- Claims --------------------------------------------------------------

scenario "No refund on cancellation once a claim has been paid"
  given bike_value 2000, rider_age 22, security gold, racing no, previous_claims 0, bike_age 0
  when bound on 2026-01-01
  when claim Theft for 1500 on 2026-03-01 with police_report, crime_reference
  expect claim paid
  when cancelled by customer on 2026-04-11
  expect refund 0

scenario "Theft claim pays up to the limit less a percentage excess"
  given bike_value 2000, rider_age 22, security gold, racing no, previous_claims 0, bike_age 0
  when bound on 2026-01-01
  when claim Theft for 1500 on 2026-03-01 with police_report, crime_reference
  expect claim paid
  expect payout 1350.00
  expect claims in term 1

scenario "Small theft claim uses the minimum excess"
  given bike_value 2000, rider_age 22, security gold, racing no, previous_claims 0, bike_age 0
  when bound on 2026-01-01
  when claim Theft for 300 on 2026-03-01 with police_report, crime_reference
  expect payout 250.00

scenario "Theft claim without a crime reference is declined"
  given bike_value 2000, rider_age 22, security gold, racing no, previous_claims 0, bike_age 0
  when bound on 2026-01-01
  when claim Theft for 1500 on 2026-03-01 with police_report
  expect claim declined "crime_reference is required"
  expect claims in term 0

scenario "Late theft notification is declined"
  given bike_value 2000, rider_age 22, security gold, racing no, previous_claims 0, bike_age 0
  when bound on 2026-01-01
  when claim Theft for 1500 on 2026-03-01 reported 2026-04-15 with police_report, crime_reference
  expect claim declined "Theft must be reported within 30 days"

scenario "Claim on an excluded cover is declined"
  given bike_value 3000, rider_age 22, security bronze, racing no, previous_claims 0, bike_age 0
  when bound on 2026-01-01
  when claim Theft for 1500 on 2026-03-01 with police_report, crime_reference
  expect claim declined "Theft is excluded: Gold or silver rated lock required"

scenario "Claim on an unselected optional cover is declined"
  given bike_value 3000, rider_age 22, security gold, racing yes, previous_claims 0, bike_age 0
  when bound on 2026-01-01
  when claim Racing for 800 on 2026-03-01
  expect claim declined "Racing is not selected"

scenario "Claim after cancellation is declined"
  given bike_value 2000, rider_age 22, security gold, racing no, previous_claims 0, bike_age 0
  when bound on 2026-01-01
  when cancelled by customer on 2026-04-11
  when claim "Accidental Damage" for 400 on 2026-05-01
  expect claim declined "policy was cancelled on 2026-05-01"

scenario "Accidental damage pays the claim less the flat excess"
  given bike_value 2000, rider_age 22, security gold, racing no, previous_claims 0, bike_age 0
  when bound on 2026-01-01
  when claim "Accidental Damage" for 600 on 2026-05-01
  expect payout 500.00

scenario "Two claims load the renewal, capped at a 20% increase"
  given bike_value 2000, rider_age 22, security gold, racing no, previous_claims 0, bike_age 0
  when bound on 2026-01-01
  when claim "Accidental Damage" for 600 on 2026-05-01
  expect renewal premium 98.17
  when claim Theft for 1000 on 2026-08-01 with police_report, crime_reference
  expect claims in term 2
  # loaded price would be 98.17 x 1.25 = 122.71; the cap is 93.97 x 1.20
  expect renewal premium 112.76
  when renewed on 2027-01-01
  expect claims in term 0

scenario "Three claims in a term decline the renewal"
  given bike_value 2000, rider_age 22, security gold, racing no, previous_claims 0, bike_age 0
  when bound on 2026-01-01
  when claim "Accidental Damage" for 600 on 2026-03-01
  when claim "Accidental Damage" for 600 on 2026-05-01
  when claim "Accidental Damage" for 600 on 2026-08-01
  expect renewal declined "Three or more claims in the year"

scenario "Depreciation: an older bike is settled at 85% before the excess"
  given bike_value 2000, rider_age 22, security gold, racing no, previous_claims 0, bike_age 2
  when bound on 2026-01-01
  when claim Theft for 1500 on 2026-03-01 with police_report, crime_reference
  # 1500 x 0.85 = 1275, less 10% of 1500
  expect payout 1125.00
